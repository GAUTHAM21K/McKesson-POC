# ==============================================================================
# Distribution Operations AI RCA Platform - Environment Configuration
# ==============================================================================

# Multi-Provider LLM Fallback Router
# The router tries providers in LLM_PROVIDER_ORDER. If one fails (429 quota, 401, timeout),
# it automatically falls over to the next available provider before using local deterministic ReAct.
LLM_PROVIDER_ORDER=groq,anthropic,openai,ollama

# 1. Groq (Fast, generous free tier - Recommended for testing: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# 2. Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4. Local Ollama (Completely free offline LLMs: https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ==============================================================================
# Enterprise Telemetry & Incident Management Live Integrations (Hybrid Adapters)
# If left blank, adapters seamlessly fall back to synthetic_poc_data.json
# ==============================================================================
SERVICENOW_API_URL=
SERVICENOW_API_KEY=
SPLUNK_API_URL=
SPLUNK_API_KEY=
